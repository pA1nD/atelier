{
  "module": "protocol/registry.js",
  "spike": "D1",
  "note": "fn ∈ allowMeta | authorizeWrite | reclaimRule; `input` is the single argument; `expect` is deep-compared. reclaimRule times are ms; H = 3 600 000.",
  "cases": [
    {
      "name": "D1 test 6: trusted/eager/isChrome/chrome/hidden stripped; primary lands in requested, not meta",
      "fn": "allowMeta",
      "input": { "name": "Todo", "icon": "✅", "group": "Work", "primary": true, "color": "#0af", "trusted": true, "eager": true, "isChrome": true, "chrome": "x", "hidden": false },
      "expect": { "meta": { "name": "Todo", "icon": "✅", "group": "Work", "color": "#0af" }, "requested": { "primary": true }, "dropped": ["trusted", "eager", "isChrome", "chrome", "hidden"], "invalid": [] }
    },
    {
      "name": "OR20: visibility in module.json is an unknown key in v1 — dropped like any other, never a request",
      "fn": "allowMeta",
      "input": { "name": "Wiki", "visibility": "company" },
      "expect": { "meta": { "name": "Wiki" }, "requested": {}, "dropped": ["visibility"], "invalid": [] }
    },
    {
      "name": "type/length limits: name > 64, group > 32, icon 9 codepoints, color not hex, primary not boolean → invalid",
      "fn": "allowMeta",
      "input": { "name": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "group": "yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy", "icon": "🎉🎉🎉🎉🎉🎉🎉🎉🎉", "color": "red", "primary": "yes" },
      "expect": { "meta": {}, "requested": {}, "dropped": [], "invalid": ["name", "group", "icon", "color", "primary"] }
    },
    {
      "name": "icon as a ≤64-char token passes; color 6-hex passes; empty name invalid",
      "fn": "allowMeta",
      "input": { "name": "  ", "icon": "lucide:calendar-days", "color": "#00AAFF" },
      "expect": { "meta": { "icon": "lucide:calendar-days", "color": "#00AAFF" }, "requested": {}, "dropped": [], "invalid": ["name"] }
    },
    { "name": "allowMeta on a non-object is empty", "fn": "allowMeta", "input": "nope", "expect": { "meta": {}, "requested": {}, "dropped": [], "invalid": [] } },
    {
      "name": "D1 test 5: computer-1's token on computer-2's row → 403 not-your-row; body.computer ignored",
      "fn": "authorizeWrite",
      "input": { "callerComputer": "comp-1", "computerRow": { "id": "comp-1", "company": "acme" }, "existingRow": { "instance_id": "i-1", "company": "acme", "slug": "todo", "computer": "comp-2" }, "body": { "slug": "todo", "computer": "comp-2" } },
      "expect": { "ok": false, "code": 403, "error": "not-your-row", "computer": "comp-2" }
    },
    {
      "name": "happy path: company derived from the computer row, primary recorded as a request",
      "fn": "authorizeWrite",
      "input": { "callerComputer": "comp-1", "computerRow": { "id": "comp-1", "company": "acme" }, "existingRow": null, "body": { "slug": "todo", "computer": "comp-9", "meta": { "name": "Todo", "primary": true, "trusted": true } } },
      "expect": { "ok": true, "row": { "company": "acme", "slug": "todo", "computer": "comp-1", "meta": { "name": "Todo" }, "requested_primary": true }, "dropped": ["trusted"], "invalid": [] }
    },
    {
      "name": "body company ≠ computer's company → 409 company-is-fixed",
      "fn": "authorizeWrite",
      "input": { "callerComputer": "comp-1", "computerRow": { "id": "comp-1", "company": "acme" }, "existingRow": null, "body": { "slug": "todo", "company": "beta" } },
      "expect": { "ok": false, "code": 409, "error": "company-is-fixed", "company": "acme" }
    },
    {
      "name": "existing row in another company (moved computer) → 409 company-is-fixed",
      "fn": "authorizeWrite",
      "input": { "callerComputer": "comp-1", "computerRow": { "id": "comp-1", "company": "acme" }, "existingRow": { "instance_id": "i-1", "company": "beta", "slug": "todo", "computer": "comp-1" }, "body": { "slug": "todo" } },
      "expect": { "ok": false, "code": 409, "error": "company-is-fixed", "company": "beta" }
    },
    { "name": "reserved company id api refused (§2)", "fn": "authorizeWrite", "input": { "callerComputer": "comp-1", "computerRow": { "id": "comp-1", "company": "api" }, "existingRow": null, "body": { "slug": "todo" } }, "expect": { "ok": false, "code": 400, "error": "reserved-company", "company": "api" } },
    { "name": "reserved company id assets refused (§2)", "fn": "authorizeWrite", "input": { "callerComputer": "comp-1", "computerRow": { "id": "comp-1", "company": "assets" }, "existingRow": null, "body": { "slug": "todo" } }, "expect": { "ok": false, "code": 400, "error": "reserved-company", "company": "assets" } },
    { "name": "reserved company id modules refused (§2, B6 surprise 7)", "fn": "authorizeWrite", "input": { "callerComputer": "comp-1", "computerRow": { "id": "comp-1", "company": "modules" }, "existingRow": null, "body": { "slug": "todo" } }, "expect": { "ok": false, "code": 400, "error": "reserved-company", "company": "modules" } },
    { "name": "reserved company id global refused (§2)", "fn": "authorizeWrite", "input": { "callerComputer": "comp-1", "computerRow": { "id": "comp-1", "company": "global" }, "existingRow": null, "body": { "slug": "todo" } }, "expect": { "ok": false, "code": 400, "error": "reserved-company", "company": "global" } },
    { "name": "reserved company id atelier refused (§2)", "fn": "authorizeWrite", "input": { "callerComputer": "comp-1", "computerRow": { "id": "comp-1", "company": "atelier" }, "existingRow": null, "body": { "slug": "todo" } }, "expect": { "ok": false, "code": 400, "error": "reserved-company", "company": "atelier" } },
    { "name": "reserved company id portal refused (§2)", "fn": "authorizeWrite", "input": { "callerComputer": "comp-1", "computerRow": { "id": "comp-1", "company": "portal" }, "existingRow": null, "body": { "slug": "todo" } }, "expect": { "ok": false, "code": 400, "error": "reserved-company", "company": "portal" } },
    { "name": "reserved company id apps refused (§2)", "fn": "authorizeWrite", "input": { "callerComputer": "comp-1", "computerRow": { "id": "comp-1", "company": "apps" }, "existingRow": null, "body": { "slug": "todo" } }, "expect": { "ok": false, "code": 400, "error": "reserved-company", "company": "apps" } },
    { "name": "reserved company id www refused (§2)", "fn": "authorizeWrite", "input": { "callerComputer": "comp-1", "computerRow": { "id": "comp-1", "company": "www" }, "existingRow": null, "body": { "slug": "todo" } }, "expect": { "ok": false, "code": 400, "error": "reserved-company", "company": "www" } },
    { "name": "reserved company id go refused (§2, the portal's /go route)", "fn": "authorizeWrite", "input": { "callerComputer": "comp-1", "computerRow": { "id": "comp-1", "company": "go" }, "existingRow": null, "body": { "slug": "todo" } }, "expect": { "ok": false, "code": 400, "error": "reserved-company", "company": "go" } },
    { "name": "shell is NOT a reserved company id (it is a reserved events topic, not in §2's list)", "fn": "authorizeWrite", "input": { "callerComputer": "comp-1", "computerRow": { "id": "comp-1", "company": "shell" }, "existingRow": null, "body": { "slug": "todo" } }, "expect": { "ok": true, "row": { "company": "shell", "slug": "todo", "computer": "comp-1", "meta": {}, "requested_primary": null }, "dropped": [], "invalid": [] } },
    {
      "name": "a spine-minted personal space (p-<id>, OR4) holds apps like any company; the prefix is reserved against CLAIMING it (validCompany), never against the computer row (ruling 2026-08-28)",
      "fn": "authorizeWrite",
      "input": { "callerComputer": "comp-1", "computerRow": { "id": "comp-1", "company": "p-ada" }, "existingRow": null, "body": { "slug": "todo" } },
      "expect": { "ok": true, "row": { "company": "p-ada", "slug": "todo", "computer": "comp-1", "meta": {}, "requested_primary": null }, "dropped": [], "invalid": [] }
    },
    {
      "name": "slug Todo refused (SLUG_RE)",
      "fn": "authorizeWrite",
      "input": { "callerComputer": "comp-1", "computerRow": { "id": "comp-1", "company": "acme" }, "existingRow": null, "body": { "slug": "Todo" } },
      "expect": { "ok": false, "code": 400, "error": "bad-slug" }
    },
    {
      "name": "slug with a trailing dash refused (§2: no leading/trailing -)",
      "fn": "authorizeWrite",
      "input": { "callerComputer": "comp-1", "computerRow": { "id": "comp-1", "company": "acme" }, "existingRow": null, "body": { "slug": "todo-" } },
      "expect": { "ok": false, "code": 400, "error": "bad-slug" }
    },
    {
      "name": "OR20: a visibility field in the body is not on the v1 wire — 400 unknown-field, never a promotion verdict",
      "fn": "authorizeWrite",
      "input": { "callerComputer": "comp-1", "computerRow": { "id": "comp-1", "company": "acme" }, "existingRow": null, "body": { "slug": "todo", "visibility": "company" } },
      "expect": { "ok": false, "code": 400, "error": "unknown-field", "field": "visibility" }
    },
    {
      "name": "any other unknown body key is 400 unknown-field (primary belongs in meta, where it becomes a request)",
      "fn": "authorizeWrite",
      "input": { "callerComputer": "comp-1", "computerRow": { "id": "comp-1", "company": "acme" }, "existingRow": null, "body": { "slug": "todo", "primary": true } },
      "expect": { "ok": false, "code": 400, "error": "unknown-field", "field": "primary" }
    },
    {
      "name": "no token → 401",
      "fn": "authorizeWrite",
      "input": { "callerComputer": null, "computerRow": null, "existingRow": null, "body": { "slug": "todo" } },
      "expect": { "ok": false, "code": 401, "error": "no-token" }
    },
    {
      "name": "token resolves to a computer the row lookup does not match → 401",
      "fn": "authorizeWrite",
      "input": { "callerComputer": "comp-1", "computerRow": { "id": "comp-2", "company": "acme" }, "existingRow": null, "body": { "slug": "todo" } },
      "expect": { "ok": false, "code": 401, "error": "unknown-computer" }
    },
    { "name": "reclaim: no row → insert", "fn": "reclaimRule", "input": { "existing": null, "callerComputer": "comp-1", "now": 100000000000 }, "expect": "insert" },
    { "name": "reclaim: live row, same computer, no .instance → adopt (D1 test 9)", "fn": "reclaimRule", "input": { "existing": { "computer": "comp-1", "tombstone_at": null }, "callerComputer": "comp-1", "now": 100000000000 }, "expect": "adopt" },
    { "name": "reclaim: tombstoned row, same computer → revive (D1 test 10)", "fn": "reclaimRule", "input": { "existing": { "computer": "comp-1", "tombstone_at": 99999000000 }, "callerComputer": "comp-1", "now": 100000000000 }, "expect": "revive" },
    { "name": "reclaim: live row, other computer → refuse-claimed (D1 test 3)", "fn": "reclaimRule", "input": { "existing": { "computer": "comp-2", "tombstone_at": null }, "callerComputer": "comp-1", "now": 100000000000 }, "expect": "refuse-claimed" },
    { "name": "reclaim: tombstoned 23 h ago, other computer → refuse-tombstoned", "fn": "reclaimRule", "input": { "existing": { "computer": "comp-2", "tombstone_at": 100000000000 }, "callerComputer": "comp-1", "now": 100082800000 }, "expect": "refuse-tombstoned" },
    { "name": "reclaim: tombstoned 25 h ago, other computer → insert (tombstone expired)", "fn": "reclaimRule", "input": { "existing": { "computer": "comp-2", "tombstone_at": 100000000000 }, "callerComputer": "comp-1", "now": 100090000000 }, "expect": "insert" },
    { "name": "reclaim: exactly 24 h is still reserved", "fn": "reclaimRule", "input": { "existing": { "computer": "comp-2", "tombstone_at": 100000000000 }, "callerComputer": "comp-1", "now": 100086399999 }, "expect": "refuse-tombstoned" }
  ]
}
