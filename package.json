{
  "name": "@pa1nd/atelier",
  "version": "0.16.0",
  "type": "module",
  "description": "The Atelier app shell \u2014 discovers, mounts, and serves feature modules around one shared chrome: a single runtime hosting many small, context-window-sized apps. Install as a dependency, run with `atelier`, install modules with `atelier add`.",
  "bin": {
    "atelier": "cli.js"
  },
  "files": [
    "CHANGELOG.md",
    "cli.js",
    "add.js",
    "update.js",
    "package.js",
    "publish.js",
    "list.js",
    "collections.js",
    "gate.js",
    "server.js",
    "build.js",
    "discovery.js",
    "chrome-resolve.js",
    "client.jsx",
    "index.html",
    "shims",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node server.js",
    "dev:module": "node server.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@tailwindcss/node": "4.2.4",
    "@tailwindcss/oxide": "4.2.4",
    "esbuild": "0.28.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "4.2.4",
    "ws": "8.21.0"
  },
  "license": "MIT",
  "author": "pA1nD",
  "homepage": "https://github.com/pA1nD/atelier#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pA1nD/atelier.git"
  },
  "bugs": {
    "url": "https://github.com/pA1nD/atelier/issues"
  },
  "keywords": [
    "atelier",
    "app-shell",
    "module-runner",
    "framework",
    "react",
    "esbuild",
    "tailwind",
    "multi-tenant",
    "agents"
  ]
}
